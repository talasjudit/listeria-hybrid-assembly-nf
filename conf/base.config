/*
========================================================================================
    Base Configuration - Process Resource Allocations
========================================================================================
    This configuration file defines resource requirements for all processes.

    Resource Strategy:
    - Each process has dedicated resource blocks that can be tuned
    - Resources scale with task.attempt for automatic retry with more resources
    - The resourceLimits directive caps requests at user-defined maximums

    Customization:
    - Adjust CPU, memory, and time values during testing and optimization
    - Resources are intentionally conservative and should be tuned for your data
    - For retry behavior, resources multiply by task.attempt on each retry
========================================================================================
*/

process {

    /*
     * Default Error Handling Strategy
     * Retry on resource-related exit codes, fail on other errors
     *
     * Exit codes that trigger retry:
     * 143 = SIGTERM (terminated)
     * 137 = SIGKILL (killed, usually OOM)
     * 104 = Connection reset
     * 134 = SIGABRT (aborted)
     * 139 = SIGSEGV (segmentation fault)
     */
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    /*
     * Resource Ceiling
     * Caps every process request at the user-defined maximums (params.max_*).
     * Replaces the old check_max() helper: the strict Nextflow config parser
     * (opt-in since 24.10, default in 26.04) no longer permits function
     * definitions in config files. resourceLimits requires Nextflow >= 24.04.
     *
     * Command-line overrides (--max_cpus / --max_memory / --max_time) flow in
     * here automatically. The ci and test profiles set their own resourceLimits
     * to tighten these for constrained environments.
     */
    resourceLimits = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]

    /*
     * Default Resource Allocations
     * These apply to any process without a specific resource block
     */
    cpus   = { 1 }
    memory = { 4.GB }
    time   = { 1.h }

    /*
     * ============================================================================
     *                       PROCESS-SPECIFIC RESOURCES
     * ============================================================================
     * Adjust these values based on your data and infrastructure
     * Resources scale with task.attempt: on retry, multiply by attempt number
     */

    /*
     * FASTP - Illumina Read QC and Trimming
     * Memory intensive for high-coverage data
     * CPU scales well with thread count
     */
    withName: 'FASTP' {
        cpus   = { 6 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    /*
     * PORECHOP_ABI - Nanopore Adapter Trimming
     * CPU intensive, moderate memory usage
     * Scales well with thread count
     */
    withName: 'PORECHOP_ABI' {
        cpus   = { 6 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    /*
     * FILTLONG - Nanopore Read Quality Filtering
     * Single-threaded, moderate memory usage
     */
    withName: 'FILTLONG' {
        cpus   = { 4 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h }
    }

    /*
     * FLYE - Long-Read Assembly
     * Very CPU and memory intensive
     * One of the most resource-hungry processes in the pipeline
     * Adjust based on genome size and read coverage
     */
    withName: 'FLYE' {
        cpus   = { 12 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    /*
     * UNICYCLER - Hybrid Assembly
     * Very CPU and memory intensive
     * Runtime highly variable depending on data complexity
     * Handles both standard hybrid and existing-assembly modes
     */
    withName: 'UNICYCLER' {
        cpus   = { 12 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    /*
     * CHECKM2 - Assembly Completeness Assessment
     * CPU intensive, moderate memory
     * Database included in container
     */
    withName: 'CHECKM2' {
        cpus   = { 8 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    /*
     * QUAST - Assembly Statistics
     * Light resource requirements
     * Fast execution
     */
    withName: 'QUAST' {
        cpus   = { 4 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h }
    }

    /*
     * MULTIQC - Aggregate QC Report
     * Light resource requirements
     * Collects and processes all QC outputs
     */
    withName: 'MULTIQC' {
        cpus   = { 4 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h }
    }

    /*
     * BWA_MEM - Short-Read Alignment for Polypolish Pre-processing
     * CPU-bound; moderate memory; runs bwa mem twice (R1 and R2 independently)
     */
    withName: 'BWA_MEM' {
        cpus   = { 8 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    /*
     * POLYPOLISH - Illumina Polishing of Flye Assembly
     * Light CPU (single-threaded polish step); moderate memory
     */
    withName: 'POLYPOLISH' {
        cpus   = { 8 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    /*
     * DNAAPLER - Chromosome Reorientation
     * Light resource requirements; fast (uses MMseqs2 protein search)
     */
    withName: 'DNAAPLER' {
        cpus   = { 4 }
        memory = { 8.GB * task.attempt }
        time   = { 1.h }
    }

    /*
     * DNADIFF_DRAFT / DNADIFF_POLISHED - Reference Comparison (MUMmer)
     * Run twice in flye_polypolish mode: Flye draft vs reference, then Polypolish vs reference.
     * ext.prefix gives each a distinct output filename so files don't collide in publishDir.
     * Light resource requirements; fast pairwise alignment.
     */
    withName: 'DNADIFF_DRAFT|DNADIFF_POLISHED' {
        cpus   = { 4 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h }
    }
    withName: 'DNADIFF_DRAFT' {
        ext.prefix = { "${meta.id}_flye_draft" }
    }
    withName: 'DNADIFF_POLISHED' {
        ext.prefix = { "${meta.id}_polypolish" }
    }

    /*
     * POLISHING_SUMMARY - Before/after polishing comparison
     * Minimal resources; bash/awk on two small dnadiff report files
     */
    withName: 'POLISHING_SUMMARY' {
        cpus   = { 1 }
        memory = { 1.GB }
        time   = { 30.m }
    }

    /*
     * CIRCULARITY_CHECK - Assembly Circularity Report
     * Minimal resources; bash/awk on small text files
     */
    withName: 'CIRCULARITY_CHECK' {
        cpus   = { 1 }
        memory = { 1.GB }
        time   = { 30.m }
    }
}
